# 文本文件统一 LF，避免 Windows/macOS 混用导致整文件 diff
* text=auto eol=lf

# 脚本保持 LF
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.c    text eol=lf
*.h    text eol=lf

# Windows 专用脚本保留 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制，不做行尾转换、不做 diff
*.png  binary
*.jpg  binary
*.pdf  binary
*.tflite binary
*.onnx binary
*.bin  binary
*.hex  binary
*.elf  binary

# 中文文档
*.md   text eol=lf
