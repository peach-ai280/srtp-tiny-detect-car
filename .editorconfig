root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{c,h}]
indent_size = 4
max_line_length = 100

[*.csv]
indent_size = 2
